# 复制为 .env 后填入真实 key
# DeepSeek API Key（留空则后端自动降级到内置 mock 话术）
DEEPSEEK_API_KEY=
# DeepSeek 接口地址（默认 https://api.deepseek.com，可换中转）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名（默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat
# 后端端口
PORT=3001
# 题目编辑器密码（留空则不允许保存）
EDITOR_PASSWORD=your_secure_password
